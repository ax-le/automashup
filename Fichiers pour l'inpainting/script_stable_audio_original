class CustomAttention(Attention):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        
        # Initialisation à zéro de TOUS les paramètres
        self._zero_init()

    def _zero_init(self):
        for name, param in self.named_parameters():
            if param.requires_grad:
                nn.init.zeros_(param)

pipe = StableAudioPipeline.from_pretrained("../models/stabilityai/stable-audio-open-1.0", torch_dtype=torch.float16,local_files_only=True,ignore_mismatched_sizes=True)

